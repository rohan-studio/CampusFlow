{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/favicon.(ico|svg)",
      "dest": "/static/favicon.svg"
    },
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ]
}
